#!/bin/sh
# Sing-box Manager init (v4.4.0)
# Запускает менеджер + sing-box + tproxy + monitor.
# Не удаляет NDMS-хук (это критично для защиты от black hole).

BIN=/opt/bin/singbox-manager
LOGFILE=/tmp/singbox-logs/manager.log
ADDR=":9091"
MARKER=/opt/etc/sing-box/vpn.disabled
SINGBOX=/opt/etc/sing-box/sing-box
CONFIG=/opt/etc/sing-box/config.d
TPROXY_INIT=/opt/etc/init.d/S55singbox-tproxy.sh
MONITOR=/opt/bin/singbox-monitor.sh
LOGDIR=/tmp/singbox-logs

ensure_logdir() {
    [ -d "$LOGDIR" ] || mkdir -p "$LOGDIR"
}

start_monitor() {
    if ! ps -w | grep -v grep | grep -q singbox-monitor; then
        ensure_logdir
        "$MONITOR" </dev/null >/dev/null 2>&1 &
    fi
}

start_singbox() {
    # v4.4.0: sing-box СТАТИЧЕСКИЙ, запускаем НАПРЯМУЮ (без ld-linux!)
    if [ -d "$CONFIG" ] && [ ! -f "$MARKER" ]; then
        if ! ps -w | grep -v grep | grep -q "sing-box run"; then
            echo "Автозапуск sing-box..."
            "$SINGBOX" run -C "$CONFIG" </dev/null > "$LOGDIR/sing-box.log" 2>&1 &
            i=0
            while [ $i -lt 15 ]; do
                if netstat -tln 2>/dev/null | grep -q ':1081 '; then
                    echo "OK: sing-box слушает 1081"
                    break
                fi
                sleep 1
                i=$((i+1))
            done
        fi
    fi
}

start_tproxy() {
    if [ -x "$TPROXY_INIT" ]; then
        # Правила применяем ТОЛЬКО если sing-box слушает 1081 (защита от black hole)
        if netstat -tln 2>/dev/null | grep -q ':1081 '; then
            "$TPROXY_INIT" start >/dev/null 2>&1 || true
            echo "OK: tproxy-правила применены"
        else
            echo "sing-box НЕ слушает 1081 — tproxy не применяем"
        fi
    fi
}

case "$1" in
    start)
        ensure_logdir
        mkdir -p /opt/var/log

        if ps -w | grep -v grep | grep -q "$BIN"; then
            echo "singbox-manager уже запущен"
        else
            echo "Запуск singbox-manager..."
            "$BIN" -addr "$ADDR" > "$LOGFILE" 2>&1 &
            sleep 3
            if ! ps -w | grep -v grep | grep -q "$BIN"; then
                echo "ОШИБКА: менеджер не запустился"
                cat "$LOGFILE"
                exit 1
            fi
            echo "OK: менеджер запущен"
        fi

        start_singbox
        start_tproxy
        start_monitor
        ;;
    stop)
        echo "Остановка..."
        killall singbox-monitor 2>/dev/null
        killall singbox-manager 2>/dev/null
        killall sing-box 2>/dev/null
        echo "OK"
        ;;
    restart)
        "$0" stop
        sleep 2
        "$0" start
        ;;
    status)
        ps -w | grep -v grep | grep -q "$BIN" && echo "singbox-manager: работает" || echo "singbox-manager: не запущен"
        ps -w | grep -v grep | grep -q "sing-box run" && echo "sing-box: работает" || echo "sing-box: не запущен"
        ps -w | grep -v grep | grep -q singbox-monitor && echo "monitor: работает" || echo "monitor: не запущен"
        netstat -tln 2>/dev/null | grep -q ':1081 ' && echo "порт 1081: слушается" || echo "порт 1081: НЕ слушается"
        ;;
    *)
        echo "Использование: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
exit 0
