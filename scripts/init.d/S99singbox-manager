#!/bin/sh
BIN=/opt/bin/singbox-manager
LOGFILE=/opt/var/log/singbox-manager.log
ADDR=":9091"

cleanup_rules() {
    for i in br0 br1 br2; do
        iptables -t mangle -D PREROUTING -i "$i" -j SINGBOX_MARK 2>/dev/null
    done
    iptables -t mangle -F SINGBOX_MARK 2>/dev/null
    iptables -t mangle -X SINGBOX_MARK 2>/dev/null
    ip rule del fwmark 0x1 table 100 2>/dev/null
    ip route del default dev singtun0 table 100 2>/dev/null
    rm -f /opt/etc/ndm/netfilter.d/50-singbox.sh
}

case "$1" in
    start)
        if ps -w | grep -v grep | grep -q "$BIN"; then
            echo "singbox-manager уже запущен"
            exit 0
        fi
        echo "Запуск singbox-manager..."
        cleanup_rules
        mkdir -p /opt/var/log
        $BIN -addr $ADDR > $LOGFILE 2>&1 &
        sleep 3
        if ps -w | grep -v grep | grep -q "$BIN"; then
            echo "OK"
        else
            echo "ОШИБКА. Лог:"
            cat $LOGFILE
            exit 1
        fi
        ;;
    stop)
        echo "Остановка..."
        cleanup_rules
        killall singbox-manager 2>/dev/null
        killall sing-box 2>/dev/null
        rm -f /opt/var/run/singbox-manager.pid
        echo "OK"
        ;;
    restart)
        $0 stop
        sleep 2
        $0 start
        ;;
    status)
        if ps -w | grep -v grep | grep -q "$BIN"; then
            echo "singbox-manager работает"
        else
            echo "singbox-manager не запущен"
        fi
        ;;
    *)
        echo "Использование: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
